DATABASE_URL=sqlite:///./payroll.db
# En producción (Supabase, connection string "Session pooler" o directa):
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:3000
# En producción, lista separada por comas (sin espacios ni corchetes), ej:
# CORS_ORIGINS=https://payroll-creator.vercel.app,http://localhost:3000

JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_NOMBRE=Administrador
ADMIN_DEFAULT_PASSWORD=cambiar-esta-clave

# URL pública del frontend, para construir el enlace del correo de
# recuperación de contraseña.
FRONTEND_URL=http://localhost:3000

# Envío del correo de "recuperar contraseña" vía la API HTTP de Resend
# (https://resend.com, gratis). Se usa HTTP en vez de SMTP porque varios
# hostings (Render en su plan gratuito incluido) bloquean las conexiones
# salientes por puertos SMTP. Crea una cuenta gratis y una API Key en
# https://resend.com/api-keys.
# Si dejas RESEND_API_KEY vacío, el enlace se registra en el log del
# servidor en vez de enviarse por correo (útil en desarrollo local).
RESEND_API_KEY=
RESEND_FROM=PAYROLL CREATOR <onboarding@resend.dev>
RESET_PASSWORD_TOKEN_MINUTOS=30
